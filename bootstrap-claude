#!/usr/bin/env bash
set -euo pipefail

_BOOTSTRAP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "${_BOOTSTRAP_DIR}/lib/bootstrap-lib.sh"

# ── components ────────────────────────────────────────────────────────────────
COMPONENTS=(
  "header|── Tools ──────────────────────────────────────────"
  "tool|Claude Code CLI|_claude_installed|_install_claude_code"
  "tool|beads|_beads_installed|_install_beads"
  "tool|codebase-memory-mcp|_cbm_installed|_install_codebase_memory_mcp"
  "header|── Plugins / Skills ───────────────────────────────"
  "plugin|andrej-karpathy-skills|andrej-karpathy-skills@karpathy-skills|forrestchang/andrej-karpathy-skills|karpathy-skills"
  "plugin|dynatrace|dynatrace@dynatrace-for-ai|dynatrace/dynatrace-for-ai|dynatrace-for-ai"
  "plugin|superpowers|superpowers@claude-plugins-official|anthropics/claude-plugins-official|claude-plugins-official"
  "plugin|context7|context7@claude-plugins-official|anthropics/claude-plugins-official|claude-plugins-official"
  "plugin|playwright|playwright@claude-plugins-official|anthropics/claude-plugins-official|claude-plugins-official"
  "plugin|claude-md-management|claude-md-management@claude-plugins-official|anthropics/claude-plugins-official|claude-plugins-official"
  "plugin|plugin-dev|plugin-dev@claude-plugins-official|anthropics/claude-plugins-official|claude-plugins-official"
  "plugin|terraform|terraform@hashicorp|hashicorp/agent-skills|hashicorp"
  "plugin|terraform-skill|terraform-skill@antonbabenko|antonbabenko/agent-plugins|antonbabenko"
  "plugin|kubernetes-skill|kubernetes-skill@kubernetes-skill|LukasNiessen/kubernetes-skill|kubernetes-skill"
  "skill|mattpocock skills (handoff)|mattpocock/skills|handoff|${MATTPOCOCK_SKILLS}"
  "header|── Grafana ────────────────────────────────────────"
  "plugin|grafana-core|grafana-core@grafana-skills|grafana/skills|grafana-skills"
  "plugin|grafana-lgtm|grafana-lgtm@grafana-skills|grafana/skills|grafana-skills"
  "plugin|grafana-cloud|grafana-cloud@grafana-skills|grafana/skills|grafana-skills"
  "plugin|grafana-k6|grafana-k6@grafana-skills|grafana/skills|grafana-skills"
  "plugin|grafana-datasources|grafana-datasources@grafana-skills|grafana/skills|grafana-skills"
  "plugin|grafana-plugins|grafana-plugins@grafana-skills|grafana/skills|grafana-skills"
  "plugin|grafana-app-sdk|grafana-app-sdk@grafana-skills|grafana/skills|grafana-skills"
  "header|── AWS ────────────────────────────────────────────"
  "skill|APEX skills (AWS EKS/ECS)|aws-samples/sample-apex-skills|eks-recon|${APEX_SKILLS}"
  "header|── Google Cloud ───────────────────────────────────"
  "skill|google skills (GKE/GCP ops)|google/skills|gke-basics|${GOOGLE_SKILLS}"
)

# ── idempotency checks ────────────────────────────────────────────────────────
_claude_installed()        { _cmd_exists claude; }

# ── install functions ─────────────────────────────────────────────────────────
_install_claude_code() {
  if _claude_installed; then ok "Claude Code CLI already present — skipping"; return 0; fi
  log "Installing Claude Code CLI..."
  _npm_install @anthropic-ai/claude-code
  ok "Claude Code CLI installed"
}

# ── run ───────────────────────────────────────────────────────────────────────
case "${1:-}" in
  --update) bootstrap_update_plugins ;;
  --list-versions) bootstrap_list_plugin_versions ;;
  *) bootstrap_run ;;
esac
